	(text "FILTER-1 : 12 dB/oct state variable filter, LM13700 OTA integrators + TL074 opamp integrators."
		(at 25.4 309.88 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "6470fac9-44a1-53e5-917c-13ab77edb02e")
	)
	(text "Cutoff = gm/(2*pi*C) ; gm = 19.2 uA/V * Iabc. Cutoff CV on CV1, resonance on CV2 (CV3/CV4 are module->core)."
		(at 25.4 316.23 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "ec29513c-e341-58c9-b27a-31fd5b8293ab")
	)
	(text "Outputs: 12 dB/oct LP / BP / HP, +/-5V AC on AUD_OUT."
		(at 25.4 322.58 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "1ba51f6e-ddf9-5b21-a178-373613737351")
	)
