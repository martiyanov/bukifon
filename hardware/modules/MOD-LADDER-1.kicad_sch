		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "6e8a8763-6f6d-5a84-bc2e-7137ffaf4e9e")
	)
	(text "Cutoff CV on CV1 (1 V/oct, exponential input VCFI pin 12), resonance on CV2. Audio in AUD_IN, out AUD_OUT +/-5V AC."
